<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ adaptive icon: solid backdrop color plus the emblem
     foreground, scaled to fit the OS's safe zone so no launcher mask
     shape (circle, squircle, rounded square) clips the spikes. Pre-8
     devices fall back to the full-bleed mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
